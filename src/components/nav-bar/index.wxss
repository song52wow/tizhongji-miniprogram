.nav-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80px;
  background-color: rgba(255, 255, 255, 0.95);
  border-top: 1px solid #E2E8F0;
  display: flex;
  align-items: flex-start;
  padding-top: 10px;
  box-shadow: 0 -4px 6px rgba(90, 155, 213, 0.08);
  z-index: 1000;
  padding-bottom: calc(env(safe-area-inset-bottom) + 4px);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.icon-box {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 20px;
  color: #94A3B8;
}

.nav-item.active .icon-text {
  color: #2563EB;
}

.nav-label {
  font-size: 12px;
  color: #94A3B8;
}

.nav-item.active .nav-label {
  color: #2563EB;
}