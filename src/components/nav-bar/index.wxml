<view class="nav-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="index"
    class="nav-item {{currentIndex === index ? 'active' : ''}}"
    bindtap="onTabTap"
    data-index="{{index}}"
  >
    <view class="icon-box {{item.bgColorClass}}">
      <text class="icon-text">{{item.icon}}</text>
    </view>
    <text class="nav-label">{{item.label}}</text>
  </view>
</view>