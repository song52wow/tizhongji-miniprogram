<view class="page">
  <view class="mini-kicker">
    <text>Today Anchor</text>
    <text>{{dateLabel}}</text>
  </view>

  <text class="page-title">今天的体重节律</text>
  <text class="page-subtitle">早晨与晚间记录会生成今日差值。</text>

  <view class="stack">
    <view class="rhythm-card primary-card">
      <view class="card-top">
        <text class="capsule morning">AM</text>
        <text class="micro">{{morningTime}}</text>
      </view>
      <view class="weight-readout">
        <text class="weight-number">{{morningWeight !== null ? morningWeight : '--'}}</text>
        <text class="weight-unit">kg</text>
      </view>
      <text class="delta">{{morningChange}}</text>
      <text wx:if="{{morningBodyFat !== null}}" class="micro bodyfat-line">体脂 {{morningBodyFat}}%</text>
    </view>

    <view wx:if="{{bmiValue}}" class="rhythm-card bmi-card {{bmiLevel}}">
      <view class="card-top">
        <text class="card-title">BMI</text>
        <text class="bmi-cat {{bmiLevel}}">{{bmiLabel}}</text>
      </view>
      <view class="weight-readout">
        <text class="weight-number">{{bmiValue}}</text>
      </view>
      <text class="micro">基于最新体重与身高计算</text>
    </view>
    <view wx:elif="{{(morningWeight !== null || eveningWeight !== null) && height === null}}" class="rhythm-card bmi-card" bindtap="onProfileTap">
      <view class="card-top">
        <text class="card-title">BMI</text>
        <text class="micro">去设置</text>
      </view>
      <text class="micro">设置身高后自动计算 BMI</text>
    </view>

    <view class="time-rail">
      <text class="capsule morning">晨</text>
      <view class="rail-line"></view>
      <text class="capsule evening">夜</text>
    </view>

    <view class="rhythm-card">
      <view class="card-top">
        <text class="capsule evening">PM</text>
        <text class="micro">{{eveningTime === '--:--' ? '未记录' : eveningTime}}</text>
      </view>
      <view class="weight-readout">
        <text class="weight-number">{{eveningWeight !== null ? eveningWeight : '--'}}</text>
        <text class="weight-unit">kg</text>
      </view>
      <text class="micro">{{eveningWeight !== null ? eveningChange : '记录后计算 evening - morning'}}</text>
      <text wx:if="{{eveningBodyFat !== null}}" class="micro bodyfat-line">体脂 {{eveningBodyFat}}%</text>
    </view>

    <view class="rhythm-card chart-card" bindtap="onChartLongPress">
      <view class="card-top">
        <text class="card-title">7天波形</text>
        <text class="micro">查看趋势</text>
      </view>
      <view class="chart-container">
        <canvas canvas-id="sparkline" type="2d" class="chart-canvas" bindlongpress="onChartLongPress"></canvas>
        <view wx:if="{{!chartReady}}" class="chart-placeholder">
          <text class="placeholder-text">加载中...</text>
        </view>
      </view>
      <view class="chart-range">
        <text class="micro">{{dateRangeStart}}</text>
        <text class="micro">今天</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-overlay">
    <text>加载中...</text>
  </view>

  <view class="fab" bindtap="onAddTap">
    <text class="fab-icon">+</text>
  </view>
</view>
