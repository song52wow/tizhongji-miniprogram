page {
  background-color: #F8FAFC;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.page {
  padding: 24px 20px 120px;
  min-height: 100vh;
}

/* 日期标题 */
.date-header {
  margin-bottom: 39px;
}

.today-title {
  display: block;
  font-size: 32px;
  font-weight: 500;
  color: #191C1D;
  margin-bottom: 4px;
}

.date-label {
  font-size: 16px;
  color: #41474F;
}

/* 体重卡片通用样式 */
.weight-card {
  background-color: white;
  border-radius: 12px;
  border: 1px solid #E1E3E4;
  padding: 25px;
  box-shadow: 0 4px 12px rgba(16, 99, 153, 0.08);
  margin-bottom: 16px;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.card-header-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-circle {
  width: 32px;
  height: 32px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.morning-icon-bg {
  background-color: #FFDBC9;
}

.evening-icon-bg {
  background-color: #E6DEFF;
}

.icon-sun {
  font-size: 16px;
}

.icon-moon {
  font-size: 16px;
}

.card-label {
  font-size: 12px;
  color: #41474F;
}

.card-time {
  font-size: 12px;
  color: #717880;
}

.weight-row {
  display: flex;
  align-items: baseline;
  gap: 4px;
  margin-bottom: 12px;
}

.weight-number {
  font-size: 48px;
  font-weight: 600;
  color: #191C1D;
  letter-spacing: -0.96px;
}

.weight-unit {
  font-size: 18px;
  color: #41474F;
  font-weight: 500;
}

.change-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.change-arrow {
  font-size: 11px;
  color: #106399;
}

.change-text {
  font-size: 16px;
  color: #106399;
}

.change-arrow-balance {
  font-size: 13px;
  color: #41474F;
}

.change-text-evening {
  font-size: 16px;
  color: #41474F;
}

/* 趋势卡片 */
.trend-card {
  background-color: white;
  border-radius: 12px;
  border: 1px solid #E1E3E4;
  padding: 26px 25px 25px;
  box-shadow: 0 4px 6px rgba(16, 99, 153, 0.06);
  margin-bottom: 16px;
}

.trend-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.trend-title {
  font-size: 24px;
  font-weight: 500;
  color: #191C1D;
}

.trend-arrow {
  font-size: 24px;
  color: #717880;
}

.chart-container {
  height: 140px;
  margin-bottom: 12px;
}

.chart-canvas {
  width: 100%;
  height: 140px;
}

.chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 140px;
}

.placeholder-text {
  color: #94A3B8;
  font-size: 14px;
}

.chart-range {
  display: flex;
  justify-content: space-between;
}

.range-label {
  font-size: 12px;
  color: #717880;
}

/* 加载遮罩 */
.loading-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20px;
  color: #94A3B8;
  font-size: 14px;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  bottom: 100px;
  right: 20px;
  width: 56px;
  height: 56px;
  background-color: #106399;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  z-index: 999;
}

.fab-icon {
  color: white;
  font-size: 28px;
  font-weight: 300;
}