page {
  background: linear-gradient(160deg, #fff1d9 0%, #fbfff6 38%, #eef7ff 100%);
}

.page {
  min-height: 100vh;
  padding: 24px 18px 120px;
  color: #172026;
}

.mini-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  color: #5F6871;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
}

.page-title {
  display: block;
  margin-bottom: 8px;
  font-size: 34px;
  line-height: 1.08;
  font-weight: 800;
  color: #172026;
}

.page-subtitle {
  display: block;
  margin-bottom: 18px;
  color: #5F6871;
  font-size: 14px;
  line-height: 1.55;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.rhythm-card {
  padding: 18px;
  border: 1px solid #DCE5DC;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10px 24px rgba(43, 72, 54, 0.09);
}

.primary-card {
  background: rgba(255, 255, 255, 0.94);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.capsule {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
}

.capsule.morning {
  background: #FFE2C9;
  color: #7D3500;
}

.capsule.evening {
  background: #E7E1FF;
  color: #2F2386;
}

.micro {
  color: #5F6871;
  font-size: 12px;
  line-height: 1.45;
}

.weight-readout {
  display: flex;
  align-items: center;
  margin: 16px 0 10px;
}

.weight-number {
  font-size: 58px;
  line-height: 1;
  font-weight: 800;
  color: #172026;
}

.weight-unit {
  display: inline-block;
  margin-left: 7px;
  color: #5F6871;
  font-size: 18px;
  font-weight: 800;
  transform: translateY(12px);
}

.delta {
  color: #087333;
  font-size: 14px;
  font-weight: 800;
}

.time-rail {
  display: grid;
  grid-template-columns: 46px 1fr 46px;
  gap: 10px;
  align-items: center;
  padding: 14px;
  border: 1px solid #DCE5DC;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10px 24px rgba(43, 72, 54, 0.09);
}

.rail-line {
  position: relative;
  height: 8px;
  border-radius: 999px;
  background: linear-gradient(90deg, #FF8A3D, #6D5DFC);
}

.rail-line::after {
  content: "";
  position: absolute;
  left: 45%;
  top: 50%;
  width: 20px;
  height: 20px;
  border: 4px solid #FFFFFF;
  border-radius: 999px;
  background: #172026;
  transform: translate(-50%, -50%);
}

.card-title {
  font-size: 20px;
  font-weight: 800;
  color: #172026;
}

.chart-container {
  position: relative;
  height: 168px;
  margin-top: 8px;
}

.chart-canvas {
  width: 100%;
  height: 168px;
}

.chart-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text,
.loading-overlay {
  color: #5F6871;
  font-size: 14px;
}

.chart-range {
  display: flex;
  justify-content: space-between;
}

.loading-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16px;
}

.fab {
  position: fixed;
  right: 18px;
  bottom: 100px;
  width: 58px;
  height: 58px;
  border-radius: 18px;
  background: #0F766E;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12px 28px rgba(15, 118, 110, 0.24);
  z-index: 999;
}

.fab-icon {
  color: #FFFFFF;
  font-size: 30px;
  font-weight: 800;
}

/* BMI 卡片 */
.card-title {
  color: #172026;
  font-size: 14px;
  font-weight: 800;
}

.bodyfat-line {
  display: block;
  margin-top: 6px;
  color: #6D5DFC;
  font-weight: 800;
}

.bmi-card {
  border-left: 4px solid #DCE5DC;
}

.bmi-card.underweight { border-left-color: #3D9BFF; }
.bmi-card.normal { border-left-color: #16A34A; }
.bmi-card.overweight { border-left-color: #FF8A3D; }
.bmi-card.obese { border-left-color: #D64253; }

.bmi-cat {
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
  color: #FFFFFF;
}

.bmi-cat.underweight { background: #3D9BFF; }
.bmi-cat.normal { background: #16A34A; }
.bmi-cat.overweight { background: #FF8A3D; }
.bmi-cat.obese { background: #D64253; }
