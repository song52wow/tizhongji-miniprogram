<view class="page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">中心控制台</text>
    <text class="page-subtitle">查看您的活动足迹与系统提醒</text>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view
      class="tab-btn {{activeTab === 0 ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="0"
    >
      <text class="tab-text">历史记录</text>
    </view>
    <view
      class="tab-btn {{activeTab === 1 ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="1"
    >
      <text class="tab-text">通知中心</text>
    </view>
  </view>

  <!-- 历史记录 Tab -->
  <view wx:if="{{activeTab === 0}}" class="tab-content">
    <block wx:if="{{loading && records.length === 0}}">
      <view class="loading-state">
        <text class="loading-text">加载中...</text>
      </view>
    </block>
    <block wx:elif="{{records.length === 0}}">
      <view class="empty-state">
        <text class="empty-text">暂无记录</text>
      </view>
    </block>
    <block wx:else>
      <view class="record-list">
        <view
          wx:for="{{records}}"
          wx:key="id"
          class="record-item"
          bindtap="onRecordTap"
          data-record="{{item}}"
          bindlongpress="onRecordLongPress"
          data-recordindex="{{index}}"
        >
          <view class="record-icon-box {{item.period === 'morning' ? 'morning' : 'evening'}}">
            <text class="record-icon">{{item.period === 'morning' ? '☀' : '🌙'}}</text>
          </view>
          <view class="record-info">
            <text class="record-date">{{item.dateLabel}}</text>
            <text wx:if="{{item.note}}" class="record-note">{{item.note}}</text>
          </view>
          <view class="record-weight">
            <text class="weight-value">{{item.weight}}</text>
            <text class="weight-unit">kg</text>
          </view>
        </view>
      </view>

      <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
        <text wx:if="{{loadingMore}}" class="loading-text">加载中...</text>
        <text wx:else class="load-more-text">加载更多</text>
      </view>
    </block>
  </view>

  <!-- 通知中心 Tab -->
  <view wx:if="{{activeTab === 1}}" class="tab-content">
    <view class="empty-state">
      <text class="empty-icon">🔔</text>
      <text class="empty-text">暂无通知</text>
    </view>
  </view>
</view>