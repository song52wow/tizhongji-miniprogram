page {
  background: #F4F7F2;
}

.page {
  min-height: 100vh;
  padding: 24px 18px 120px;
  color: #172026;
}

.mini-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  color: #5F6871;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
}

.page-title {
  display: block;
  margin-bottom: 8px;
  font-size: 34px;
  line-height: 1.08;
  font-weight: 800;
  color: #172026;
}

.page-subtitle {
  display: block;
  margin-bottom: 18px;
  color: #5F6871;
  font-size: 14px;
  line-height: 1.55;
}

.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 14px;
  padding: 8px;
  border: 1px solid #DCE5DC;
  border-radius: 14px;
  background: #FFFFFF;
  box-shadow: 0 10px 24px rgba(43, 72, 54, 0.06);
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  border-radius: 8px;
  color: #5F6871;
  font-size: 15px;
  font-weight: 800;
}

.tab.active {
  background: #172026;
  color: #FFFFFF;
}

.tab-content {
  min-height: 240px;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.record-item {
  display: grid;
  grid-template-columns: 44px 1fr auto;
  gap: 12px;
  align-items: center;
  padding: 13px;
  border: 1px solid #DCE5DC;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10px 24px rgba(43, 72, 54, 0.09);
}

.capsule {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
}

.capsule.morning {
  background: #FFE2C9;
  color: #7D3500;
}

.capsule.evening {
  background: #E7E1FF;
  color: #2F2386;
}

.capsule.signal {
  width: max-content;
  background: #DFF8E8;
  color: #087333;
}

.capsule.notice {
  width: max-content;
  background: #DFF3FF;
  color: #0F5E88;
}

.record-main {
  min-width: 0;
}

.record-date {
  display: block;
  color: #172026;
  font-size: 17px;
  font-weight: 800;
}

.record-note {
  display: block;
  margin-top: 4px;
  color: #5F6871;
  font-size: 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-weight {
  text-align: right;
}

.record-number {
  display: block;
  color: #172026;
  font-size: 30px;
  line-height: 1;
  font-weight: 800;
}

.record-unit {
  display: block;
  margin-top: 4px;
  color: #5F6871;
  font-size: 12px;
  font-weight: 800;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  margin-top: 14px;
  color: #0F766E;
  font-size: 14px;
  font-weight: 800;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 220px;
  gap: 8px;
  color: #5F6871;
}

.empty-title {
  color: #172026;
  font-size: 20px;
  font-weight: 800;
}

.empty-text {
  color: #5F6871;
  font-size: 14px;
}

.notice-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 16px;
  border: 1px solid rgba(25, 146, 212, 0.28);
  border-radius: 22px;
  background: #DFF3FF;
  box-shadow: 0 10px 24px rgba(43, 72, 54, 0.09);
  margin-bottom: 12px;
}

.notice-card.muted {
  border-color: #DCE5DC;
  background: rgba(255, 255, 255, 0.9);
}

.notice-title {
  color: #172026;
  font-size: 17px;
  font-weight: 800;
}

.notice-body {
  color: #5F6871;
  font-size: 13px;
  line-height: 1.55;
}
