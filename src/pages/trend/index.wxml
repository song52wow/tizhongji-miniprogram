<view class="page">
  <view class="mini-kicker">
    <text>Rhythm Graph</text>
    <text>{{rangeLabels[selectedRangeIndex]}}</text>
  </view>

  <text class="page-title">周期洞察</text>
  <text class="page-subtitle">用早晚双线观察体重走势和日内波动。</text>

  <view class="stack">
    <view class="range-filter">
      <view
        wx:for="{{rangeLabels}}"
        wx:key="index"
        class="range-btn {{selectedRangeIndex === index ? 'active' : ''}}"
        bindtap="onRangeChange"
        data-index="{{index}}"
      >
        <text>{{item}}</text>
      </view>
    </view>

    <view class="rhythm-card chart-card">
      <view class="card-top">
        <text class="card-title">早晚双线</text>
        <view class="legend">
          <text class="legend-dot morning"></text>
          <text>早</text>
          <text class="legend-dot evening"></text>
          <text>晚</text>
        </view>
      </view>
      <view class="chart-body">
        <canvas canvas-id="trendChart" type="2d" class="trend-chart" bindtouchend="onChartTouch"></canvas>
        <view wx:if="{{!loading && morningData.length === 0 && eveningData.length === 0}}" class="chart-empty">
          <text class="empty-text">记录第一天的体重吧</text>
        </view>
      </view>
    </view>

    <view class="stat-grid">
      <view class="stat-card">
        <text class="stat-label">平均早体重</text>
        <view class="stat-value-row">
          <text class="stat-value morning">{{avgMorningWeight}}</text>
          <text class="stat-unit">kg</text>
        </view>
      </view>

      <view class="stat-card">
        <text class="stat-label">平均晚体重</text>
        <view class="stat-value-row">
          <text class="stat-value evening">{{avgEveningWeight}}</text>
          <text class="stat-unit">kg</text>
        </view>
      </view>

      <view class="stat-card wide">
        <text class="stat-label">周期变化</text>
        <view class="stat-value-row">
          <text class="stat-value signal">{{changeDisplay}}</text>
          <text class="stat-unit">kg / {{rangeLabels[selectedRangeIndex]}}</text>
        </view>
      </view>

      <view class="stat-card">
        <text class="stat-label">最低体重</text>
        <view class="stat-value-row">
          <text class="stat-value">{{minWeight}}</text>
          <text class="stat-unit">kg</text>
        </view>
        <text wx:if="{{minWeightDate}}" class="stat-subtext">{{minWeightDate}}</text>
      </view>

      <view class="stat-card">
        <text class="stat-label">最高体重</text>
        <view class="stat-value-row">
          <text class="stat-value">{{maxWeight}}</text>
          <text class="stat-unit">kg</text>
        </view>
        <text wx:if="{{maxWeightDate}}" class="stat-subtext">{{maxWeightDate}}</text>
      </view>

      <view class="stat-card wide soft">
        <text class="stat-label">平均早晚差值</text>
        <view class="stat-value-row">
          <text class="stat-value">{{avgWeightDiff}}</text>
          <text class="stat-unit">kg</text>
        </view>
        <text class="stat-subtext">{{avgDiffSubtext}}</text>
      </view>
    </view>
  </view>
</view>
