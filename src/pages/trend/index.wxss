page {
  background: linear-gradient(160deg, #fff1d9 0%, #fbfff6 38%, #eef7ff 100%);
}

.page {
  min-height: 100vh;
  padding: 24px 18px 120px;
  color: #172026;
}

.mini-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  color: #5F6871;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
}

.page-title {
  display: block;
  margin-bottom: 8px;
  font-size: 34px;
  line-height: 1.08;
  font-weight: 800;
  color: #172026;
}

.page-subtitle {
  display: block;
  margin-bottom: 18px;
  color: #5F6871;
  font-size: 14px;
  line-height: 1.55;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.range-filter {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  padding: 8px;
  border: 1px solid #DCE5DC;
  border-radius: 14px;
  background: #FFFFFF;
  box-shadow: 0 10px 24px rgba(43, 72, 54, 0.06);
}

.range-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  border-radius: 8px;
  color: #5F6871;
  font-size: 14px;
  font-weight: 800;
}

.range-btn.active {
  background: #172026;
  color: #FFFFFF;
}

.rhythm-card,
.stat-card {
  border: 1px solid #DCE5DC;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10px 24px rgba(43, 72, 54, 0.09);
}

.chart-card {
  padding: 18px;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}

.card-title {
  color: #172026;
  font-size: 20px;
  font-weight: 800;
}

.legend {
  display: flex;
  align-items: center;
  gap: 4px;
  color: #5F6871;
  font-size: 12px;
  font-weight: 700;
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
}

.legend-dot.morning {
  background: #FF8A3D;
}

.legend-dot.evening {
  background: #6D5DFC;
  margin-left: 6px;
}

.legend-dot.bodyfat {
  background: #0EA5A5;
}

.bodyfat-chart {
  width: 100%;
  height: 178px;
}

.chart-body {
  position: relative;
  height: 178px;
}

.trend-chart {
  width: 100%;
  height: 178px;
}

.chart-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  color: #5F6871;
  font-size: 14px;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.stat-card {
  min-height: 122px;
  padding: 15px;
}

.stat-card.wide {
  grid-column: 1 / -1;
  background: #DFF8E8;
  border-color: rgba(34, 197, 94, 0.28);
}

.stat-card.soft {
  background: rgba(255, 255, 255, 0.9);
}

.stat-label {
  color: #5F6871;
  font-size: 12px;
  line-height: 1.45;
}

.stat-value-row {
  display: flex;
  align-items: flex-end;
  gap: 5px;
  margin-top: 16px;
}

.stat-value {
  color: #172026;
  font-size: 30px;
  line-height: 1;
  font-weight: 800;
}

.stat-value.morning {
  color: #FF8A3D;
}

.stat-value.evening {
  color: #6D5DFC;
}

.stat-value.signal {
  color: #087333;
}

.stat-unit {
  color: #5F6871;
  font-size: 12px;
  font-weight: 700;
}

.stat-subtext {
  display: block;
  margin-top: 6px;
  color: #5F6871;
  font-size: 12px;
  line-height: 1.45;
}
