<view class="page">
  <view class="mini-kicker">
    <text>Log Console</text>
    <text>v2</text>
  </view>

  <text class="page-title">称重控制台</text>
  <text class="page-subtitle">选择日期和时段，同日早晚各保留一条记录。</text>

  <view class="stack">
    <view class="field">
      <text class="field-label">日期</text>
      <picker mode="date" value="{{selectedDate}}" start="2000-01-01" end="{{maxDate}}" bindchange="onDateChange">
        <view class="field-box date-box">
          <text>{{selectedDate}}</text>
          <text class="field-arrow">⌄</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">时段</text>
      <view class="period-switch">
        <view
          class="period-option morning {{selectedPeriod === 'morning' ? 'active' : ''}}"
          bindtap="onPeriodChange"
          data-period="morning"
        >
          <text>早晨锚点</text>
        </view>
        <view
          class="period-option evening {{selectedPeriod === 'evening' ? 'active' : ''}}"
          bindtap="onPeriodChange"
          data-period="evening"
        >
          <text>晚间回声</text>
        </view>
      </view>
    </view>

    <view class="weight-console">
      <input
        class="weight-input"
        type="digit"
        placeholder="70.0"
        value="{{weightInput}}"
        bindinput="onWeightInput"
        confirm-type="done"
      />
      <text class="weight-suffix">kg</text>
    </view>

    <view wx:if="{{bmiValue}}" class="bmi-badge {{bmiLevel}}">
      <text class="bmi-label">BMI</text>
      <text class="bmi-number">{{bmiValue}}</text>
      <text class="bmi-cat">{{bmiLabel}}</text>
    </view>
    <text wx:elif="{{weightInput && height === null}}" class="bmi-hint">
      设置身高后自动计算 BMI（前往「我的」）
    </text>

    <text wx:if="{{existingRecord}}" class="existing-hint">
      已有记录，保存将覆盖{{selectedPeriod === 'morning' ? '早晨锚点' : '晚间回声'}}。
    </text>

    <view class="field">
      <text class="field-label">体脂率（可选）</text>
      <view class="field-box bodyfat-box">
        <input
          class="bodyfat-input"
          type="digit"
          placeholder="如 22.5"
          value="{{bodyFatInput}}"
          bindinput="onBodyFatInput"
          confirm-type="done"
        />
        <text class="bodyfat-suffix">%</text>
      </view>
    </view>

    <view class="field">
      <text class="field-label">备注</text>
      <view class="field-box note-box">
        <textarea
          class="note-input"
          placeholder="空腹，训练日"
          maxlength="200"
          value="{{noteInput}}"
          bindinput="onNoteInput"
        ></textarea>
      </view>
    </view>

    <text wx:if="{{errorMsg}}" class="error-msg">{{errorMsg}}</text>

    <view class="save-btn {{saving ? 'saving' : ''}}" bindtap="onSaveTap">
      <view wx:if="{{saving}}" class="save-loading"></view>
      <text>{{saving ? '保存中...' : '保存记录'}}</text>
    </view>
  </view>
</view>
