page {
  background-color: #F8FAFC;
}

.page {
  padding: 24px 20px 120px;
  min-height: 100vh;
}

/* 页面标题 */
.page-title {
  font-size: 32px;
  font-weight: 500;
  color: #191C1D;
  margin-bottom: 40px;
}

/* 输入卡片 */
.input-card {
  background-color: white;
  border-radius: 12px;
  border: 1px solid rgba(193, 199, 209, 0.5);
  padding: 25px;
  box-shadow: 0 4px 12px rgba(16, 99, 153, 0.08);
  margin-bottom: 12px;
}

.field-section {
  margin-bottom: 24px;
}

.field-section:last-child {
  margin-bottom: 0;
}

/* 日期选择 */
.field-label {
  display: block;
  font-size: 12px;
  font-weight: 500;
  color: #41474F;
  letter-spacing: 0.6px;
  margin-bottom: 4px;
}

.date-picker {
  display: flex;
  align-items: center;
  background-color: #EDEEEF;
  border-radius: 8px;
  padding: 13px;
}

.date-icon {
  font-size: 16px;
  margin-right: 8px;
}

.date-value {
  flex: 1;
  font-size: 16px;
  color: #191C1D;
}

.date-arrow {
  font-size: 12px;
  color: #191C1D;
}

/* 时段切换 */
.period-toggle {
  display: flex;
  gap: 12px;
  background-color: #EDEEEF;
  border-radius: 8px;
  padding: 4px;
}

.period-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 12px;
  border-radius: 6px;
  transition: all 0.2s;
}

.period-btn.inactive {
  background-color: transparent;
}

.period-icon {
  font-size: 16px;
}

.period-text {
  font-size: 16px;
  font-weight: 500;
}

/* 早晨激活态 */
.period-btn.morning.active {
  background-color: #9B4500;
}

.period-btn.morning.active .period-icon,
.period-btn.morning.active .period-text {
  color: white;
}

.period-btn.morning.inactive .period-icon,
.period-btn.morning.inactive .period-text {
  color: #41474F;
}

/* 晚上激活态 */
.period-btn.evening.active {
  background-color: #6042D6;
}

.period-btn.evening.active .period-icon,
.period-btn.evening.active .period-text {
  color: white;
}

.period-btn.evening.inactive .period-icon,
.period-btn.evening.inactive .period-text {
  color: #41474F;
}

/* 体重输入 */
.weight-input-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weight-input-box {
  display: flex;
  align-items: baseline;
  justify-content: center;
  background-color: #EDEEEF;
  border-radius: 8px;
  padding: 42px 13px;
  width: 100%;
}

.weight-input {
  font-size: 48px;
  font-weight: 600;
  color: #106399;
  letter-spacing: -0.96px;
  text-align: center;
  background: transparent;
  width: 200px;
}

.weight-input::placeholder {
  color: #C1C7D1;
  font-size: 48px;
  font-weight: 600;
}

.weight-suffix {
  font-size: 16px;
  color: #41474F;
  margin-left: 4px;
}

.existing-hint {
  font-size: 12px;
  color: #717880;
  margin-top: 8px;
}

/* 备注输入 */
.note-box {
  background-color: #EDEEEF;
  border-radius: 8px;
  padding: 13px;
  min-height: 61px;
}

.note-input {
  font-size: 16px;
  color: #191C1D;
  width: 100%;
  min-height: 40px;
  background: transparent;
}

.note-input::placeholder {
  color: #C1C7D1;
  font-size: 16px;
}

/* 错误提示 */
.error-msg {
  display: block;
  color: #BA1A1A;
  font-size: 14px;
  margin-top: 12px;
  margin-left: 4px;
}

/* 保存按钮 */
.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 16px 0;
  background-color: #106399;
  border-radius: 999px;
  box-shadow: 0 4px 8px rgba(16, 99, 153, 0.2);
  margin-top: 12px;
}

.save-btn.disabled,
.save-btn.saving {
  opacity: 0.7;
}

.save-btn-icon {
  color: white;
  font-size: 18px;
}

.save-btn-text {
  color: white;
  font-size: 18px;
  font-weight: 500;
}

.save-loading {
  width: 20px;
  height: 20px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}