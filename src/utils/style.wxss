/* 全局样式 token */
page {
  --paper: #FFFAF0;
  --canvas: #F4F7F2;
  --panel: #FFFFFF;
  --ink: #172026;
  --muted: #5F6871;
  --line: #DCE5DC;
  --line-strong: #C6D3C7;
  --morning: #FF8A3D;
  --morning-ink: #7D3500;
  --morning-soft: #FFE2C9;
  --evening: #6D5DFC;
  --evening-ink: #2F2386;
  --evening-soft: #E7E1FF;
  --action: #0F766E;
  --action-soft: #D9F3EE;
  --signal: #22C55E;
  --signal-soft: #DFF8E8;
  --notice: #1992D4;
  --notice-soft: #DFF3FF;
  --danger: #D64253;

  --card-radius: 22px;
  --card-radius-large: 28px;
  --card-radius-small: 14px;
  --card-gap: 16px;
  --card-padding: 18px;
  --page-padding: 18px;
  --nav-height: 80px;
  --fab-size: 58px;
  --fab-radius: 18px;

  background-color: var(--canvas);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 通用卡片样式 */
.card {
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: var(--card-radius);
  border: 1px solid var(--line);
  padding: var(--card-padding);
  box-shadow: 0 10px 24px rgba(43, 72, 54, 0.09);
}

/* 页面内容容器 */
.page-content {
  padding: 24px 18px 120px;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  bottom: 100px;
  right: 18px;
  width: 58px;
  height: 58px;
  background-color: var(--action);
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12px 28px rgba(15, 118, 110, 0.24);
  z-index: 100;
}

.fab-icon {
  color: white;
  font-size: 24px;
}
